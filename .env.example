# Deriv API Token (Get this from Deriv -> Account Settings -> API Token)
# Be sure to create a token with 'read' and 'trade' scopes on your DEMO account!
DERIV_API_TOKEN=your_deriv_demo_api_token_here

# Deriv App ID (1089 is Deriv's default public app ID for general apps/testing)
DERIV_APP_ID=1089

# Watchlist of Volatility Indices to Scan
WATCHLIST=R_100,R_75,R_50,R_25,R_10,1HZ100V,1HZ75V,1HZ50V

# Timeframes in seconds (14400 = 4H Macro, 3600 = 1H Structure)
MACRO_TIMEFRAME=14400
DETAIL_TIMEFRAME=3600

# Risk Management
STAKE_AMOUNT=10.0
MULTIPLIER=100
RR_RATIO=3.0
BREAKEVEN_R=1.5
PIVOT_LOOKBACK=5
MACRO_EMA_PERIOD=50

# Web Server Port (Automatically set by Render)
PORT=10000
